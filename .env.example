# Shared environment for the whole stack (infra + all modules).
# Copy this file to `.env` and adjust values. `.env` is auto-loaded by
# `docker compose` from the project root for every included compose file.

COMPOSE_PROJECT_NAME=bung

# ---- gateway ----
NGINX_PORT=8080

# ---- postgres (shared by all modules, one DB, one schema per module) ----
POSTGRES_USER=bung
POSTGRES_PASSWORD=bung
POSTGRES_DB=bung
# NOTE: host port, not the in-network port (containers always reach it at
# postgres:5432). Default here is a high, uncommon port - a machine with
# ANY native/local Postgres install (even several, e.g. one per version)
# will already have 5432-5439ish taken, which silently routes host tools
# (DBeaver, psql, ...) to the WRONG server instead of failing loudly - same
# symptom as a wrong password. If this still collides, check for other
# LISTENING ports first (`netstat -ano`) before picking another one.
POSTGRES_PORT=55432

# ---- auth (session JWT, signed/verified only by app-maintenance) ----
# Generate your own: `openssl rand -hex 32`. Required - compose refuses to
# start app-maintenance-backend without it.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
AUTH_TOKEN_TTL_HOURS=12
# Only used the very first time (to seed the "admin" user) - change it via
# the Users tab's "Set Password" action afterwards, this var isn't reread.
SEED_ADMIN_PASSWORD=change-me-before-first-run

# Used to build links in emails (forgot-password). Set this to wherever
# users actually reach the site from (e.g. https://bung.example.com once
# behind Cloudflare) - it's not auto-detected.
PUBLIC_BASE_URL=http://localhost:8080

# ---- email (forgot-password) ----
# Leave SMTP_HOST empty to have emails logged instead of sent (see
# app-maintenance-backend logs) - handy for testing the flow before you
# have real SMTP credentials. Fill these in and restart when you do; no
# code changes needed either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bung.local

# ---- module: app-maintenance ----
APP_MAINTENANCE_BACKEND_PORT=8080
APP_MAINTENANCE_VITE_BASE=/app-maintenance/
APP_MAINTENANCE_DB_SCHEMA=app_maintenance

# ---- module: kanban ----
KANBAN_BACKEND_PORT=8080
KANBAN_VITE_BASE=/kanban/
KANBAN_DB_SCHEMA=kanban

# When you add a new module, add its own PORT / VITE_BASE / DB_SCHEMA
# below, following the same <MODULE>_<KEY> convention.
