# Shared environment for the whole stack (infra + all modules).
# Copy this file to `.env` and adjust values. `.env` is auto-loaded by
# `docker compose` from the project root for every included compose file.

COMPOSE_PROJECT_NAME=bung

# ---- gateway ----
NGINX_PORT=8080

# ---- module: app-maintenance ----
APP_MAINTENANCE_BACKEND_PORT=8080
APP_MAINTENANCE_VITE_BASE=/app-maintenance/

# When you add a new module, add its own PORT / VITE_BASE (or other
# shared config) below, following the same <MODULE>_<KEY> convention.
