# Shared environment for the whole stack (infra + all modules).
# Copy this file to `.env` and adjust values. `.env` is auto-loaded by
# `docker compose` from the project root for every included compose file.

COMPOSE_PROJECT_NAME=bung

# ---- gateway ----
NGINX_PORT=8080

# ---- postgres (shared by all modules, one DB, one schema per module) ----
POSTGRES_USER=bung
POSTGRES_PASSWORD=bung
POSTGRES_DB=bung
POSTGRES_PORT=5432

# ---- module: app-maintenance ----
APP_MAINTENANCE_BACKEND_PORT=8080
APP_MAINTENANCE_VITE_BASE=/app-maintenance/
APP_MAINTENANCE_DB_SCHEMA=app_maintenance

# ---- module: kanban ----
KANBAN_BACKEND_PORT=8080
KANBAN_VITE_BASE=/kanban/
KANBAN_DB_SCHEMA=kanban

# When you add a new module, add its own PORT / VITE_BASE / DB_SCHEMA
# below, following the same <MODULE>_<KEY> convention.
